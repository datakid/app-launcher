{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LinkExpress links.json",
  "description": "Catalog of categories, apps and variants shown by the launcher. Mirrors the limits the app enforces when it loads the catalog.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "description": "Tab categories. The app reads at most 12.",
      "items": {
        "$ref": "#/definitions/category"
      }
    }
  },
  "required": [
    "categories"
  ],
  "additionalProperties": false,
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "description": "Lowercase letters, digits and hyphens, starting with a letter or digit, up to 40 characters."
    },
    "hex": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "Six-digit hex colour such as #7c9bff."
    },
    "icon": {
      "type": "string",
      "pattern": "^fa-[a-z0-9]+(?:-[a-z0-9]+){0,6}$",
      "description": "Font Awesome solid icon name. Names outside the built-in set are fetched on demand; a name that cannot be fetched falls back to fa-circle.",
      "examples": [
        "fa-arrow-right-to-bracket",
        "fa-arrow-up-right-from-square",
        "fa-bolt",
        "fa-book",
        "fa-book-medical",
        "fa-box-open",
        "fa-briefcase",
        "fa-calculator",
        "fa-calendar-days",
        "fa-chart-area",
        "fa-chart-column",
        "fa-chart-line",
        "fa-check",
        "fa-circle",
        "fa-circle-dot",
        "fa-clone",
        "fa-compass",
        "fa-compress",
        "fa-copy",
        "fa-crosshairs",
        "fa-dollar-sign",
        "fa-expand",
        "fa-eye",
        "fa-file-contract",
        "fa-file-lines",
        "fa-filter",
        "fa-flask",
        "fa-folder-open",
        "fa-font",
        "fa-heart-pulse",
        "fa-id-card",
        "fa-language",
        "fa-layer-group",
        "fa-list-check",
        "fa-magnifying-glass",
        "fa-magnifying-glass-chart",
        "fa-moon",
        "fa-pills",
        "fa-ranking-star",
        "fa-rotate-right",
        "fa-scale-balanced",
        "fa-search",
        "fa-sliders",
        "fa-square-root-variable",
        "fa-sun",
        "fa-triangle-exclamation",
        "fa-user-secret",
        "fa-volume-mute",
        "fa-volume-up"
      ]
    },
    "gradient": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/definitions/hex"
      },
      "description": "Three hex colours: base, light and dark."
    },
    "variant": {
      "type": "object",
      "properties": {
        "id": {
          "allOf": [
            {
              "$ref": "#/definitions/id"
            }
          ],
          "description": "Unique among the variants of one app."
        },
        "label": {
          "description": "Chip label shown on the card.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            {
              "type": "object",
              "properties": {
                "ar": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "Arabic text"
                },
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "English text"
                }
              },
              "required": [
                "ar",
                "en"
              ],
              "additionalProperties": false
            }
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/@\\s]+(?:/\\S*)?$",
          "maxLength": 2048,
          "description": "https address only."
        },
        "icon": {
          "$ref": "#/definitions/icon"
        }
      },
      "required": [
        "id",
        "label",
        "url"
      ],
      "additionalProperties": false
    },
    "app": {
      "type": "object",
      "properties": {
        "id": {
          "allOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "not": {
                "pattern": "^u-"
              }
            }
          ],
          "description": "Unique across the whole catalog. The u- prefix is reserved for user links."
        },
        "title": {
          "description": "Card title.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            {
              "type": "object",
              "properties": {
                "ar": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "Arabic text"
                },
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "English text"
                }
              },
              "required": [
                "ar",
                "en"
              ],
              "additionalProperties": false
            }
          ]
        },
        "icon": {
          "$ref": "#/definitions/icon"
        },
        "gradient": {
          "$ref": "#/definitions/gradient"
        },
        "color": {
          "allOf": [
            {
              "$ref": "#/definitions/hex"
            }
          ],
          "description": "Single colour; when set, the app derives the gradient from it and ignores gradient."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/@\\s]+(?:/\\S*)?$",
          "maxLength": 2048,
          "description": "https address. Ignored when variants is present."
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/variant"
          },
          "description": "Alternative links shown as chips on one card. At most 4."
        },
        "defaultVariant": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Zero-based index into variants."
        },
        "closed": {
          "type": "boolean",
          "description": "Visual-only closed styling and label."
        },
        "closedReason": {
          "description": "Optional reason shown with the closed label.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            {
              "type": "object",
              "properties": {
                "ar": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "Arabic text"
                },
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "English text"
                }
              },
              "required": [
                "ar",
                "en"
              ],
              "additionalProperties": false
            }
          ]
        },
        "isNew": {
          "type": "boolean",
          "description": "Shows the New badge while the since date is recent."
        },
        "since": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date",
          "description": "YYYY-MM-DD date the app was added."
        },
        "variantBadge": {
          "type": "string",
          "maxLength": 24,
          "description": "Small badge text on the card."
        }
      },
      "required": [
        "id",
        "title"
      ],
      "anyOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "variants"
          ]
        }
      ],
      "dependencies": {
        "defaultVariant": [
          "variants"
        ]
      },
      "additionalProperties": false
    },
    "category": {
      "type": "object",
      "properties": {
        "id": {
          "allOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "not": {
                "const": "mine"
              }
            }
          ],
          "description": "Unique among categories. The id mine is reserved for user links."
        },
        "label": {
          "description": "Tab label.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            {
              "type": "object",
              "properties": {
                "ar": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "Arabic text"
                },
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "English text"
                }
              },
              "required": [
                "ar",
                "en"
              ],
              "additionalProperties": false
            }
          ]
        },
        "icon": {
          "$ref": "#/definitions/icon"
        },
        "accent": {
          "$ref": "#/definitions/hex"
        },
        "key": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "Keyboard shortcut slot."
        },
        "apps": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/definitions/app"
          },
          "description": "At most 24 per category."
        }
      },
      "required": [
        "id",
        "label",
        "apps"
      ],
      "additionalProperties": false
    }
  }
}
