{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Icon manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "icons"],
  "properties": {
    "version": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "icons": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9-]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["favicon", "glyph", "tint", "status", "checkedAt", "hash"],
        "properties": {
          "favicon": { "type": ["string", "null"], "pattern": "^icons/[a-z0-9-]+\\.png\\?v=[0-9a-f]{8}$" },
          "glyph": { "type": ["string", "null"], "pattern": "^icons/[a-z0-9-]+\\.glyph\\.png\\?v=[0-9a-f]{8}$" },
          "tint": {
            "type": ["array", "null"],
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "string", "pattern": "^#[0-9a-f]{6}$" }
          },
          "sourceTint": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "string", "pattern": "^#[0-9a-f]{6}$" }
          },
          "status": { "enum": ["found", "override", "stale", "blocked", "default"] },
          "checkedAt": { "type": ["string", "null"], "format": "date-time" },
          "hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
