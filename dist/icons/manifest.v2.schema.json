{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LinkExpress icon manifest v2",
  "type": "object",
  "required": ["version", "generatedAt", "hash", "atlas", "glyphAtlas", "glyphSprite", "icons"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "generatedAt": { "type": "string" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
    "atlas": { "$ref": "#/definitions/atlas" },
    "glyphAtlas": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/atlas" }] },
    "glyphSprite": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "properties": { "file": { "type": "string", "pattern": "^icons/glyphs\\.[0-9a-f]{8}\\.svg$" } }
    },
    "icons": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/icon" }
    }
  },
  "definitions": {
    "atlas": {
      "type": "object",
      "required": ["file", "width", "height", "cell"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "pattern": "^icons/(glyph-)?atlas\\.[0-9a-f]{8}\\.webp$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "cell": { "type": "integer", "minimum": 1 }
      }
    },
    "cellPos": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } }
    },
    "tint": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
    },
    "icon": {
      "type": "object",
      "required": ["favicon", "glyph", "tint", "shape", "status", "checkedAt", "hash"],
      "properties": {
        "favicon": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/cellPos" }] },
        "glyph": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "required": ["symbol"], "additionalProperties": false, "properties": { "symbol": { "type": "string", "pattern": "^g-[a-z0-9-]+$" } } },
            { "type": "object", "required": ["atlas"], "additionalProperties": false, "properties": { "atlas": { "$ref": "#/definitions/cellPos" } } }
          ]
        },
        "tint": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/tint" }] },
        "sourceTint": { "$ref": "#/definitions/tint" },
        "shape": { "enum": ["default", "squircle", "circle", "rounded", "hexagon"] },
        "status": { "enum": ["found", "stale", "blocked", "default", "override"] },
        "checkedAt": { "type": "string" },
        "hash": { "type": "string" },
        "palette": { "type": ["string", "null"] },
        "seed": { "type": ["string", "null"], "pattern": "^[0-9a-f]{8}$" },
        "locked": { "type": "boolean" }
      }
    }
  }
}
