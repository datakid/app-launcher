{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(app\\.[0-9a-f]{8}\\.(?:css|js))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/icons/(atlas|glyph-atlas|glyphs)\\.([0-9a-f]{8})\\.(webp|svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(|index\\.html|sw\\.js|links\\.json|icons/manifest\\.v2\\.json)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
